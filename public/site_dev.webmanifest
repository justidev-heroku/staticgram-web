{
    "name": "StaticGram Web",
    "short_name": "StaticGram",
    "description": "StaticGram Web — messaging client for the StaticGram network.",
    "start_url": "./",
    "icons": [
        {
            "src": "icon-dev-192x192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "icon-dev-384x384.png",
            "sizes": "384x384",
            "type": "image/png"
        },
        {
            "src": "icon-dev-512x512.png",
            "sizes": "512x512",
            "type": "image/png"
        }
    ],
    "share_target": {
        "action": "./share/",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                {
                    "name": "files",
                    "accept": "*/*"
                }
            ]
        }
    },
    "theme_color": "#ffffff",
    "background_color": "#ffffff",
    "display": "standalone"
}
